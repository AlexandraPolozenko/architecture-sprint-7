        <mxCell id="sRmAjBo_A13cr_bpGwoU-1803" value="Некорректно проведенные сделки по недвижимости. Могут повлечь финансовые и репутационные потери." style="rounded=1;whiteSpace=wrap;html=1;shadow=0;labelBackgroundColor=none;strokeColor=none;strokeWidth=3;fillColor=#61c6ce;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;align=center;spacing=5;fontStyle=0;arcSize=7;perimeterSpacing=2;container=0;" parent="1" vertex="1">
