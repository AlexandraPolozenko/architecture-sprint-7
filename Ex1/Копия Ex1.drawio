        </mxCell>
        <mxCell id="sRmAjBo_A13cr_bpGwoU-1818" value="Несанкционированный доступ ко всем компонентам системы. Риск для всех остальных данных." style="rounded=1;whiteSpace=wrap;html=1;shadow=0;labelBackgroundColor=none;strokeColor=none;strokeWidth=3;fillColor=#64bbe2;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;align=center;spacing=5;arcSize=7;perimeterSpacing=2;container=0;" parent="1" vertex="1">
